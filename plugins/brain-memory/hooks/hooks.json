{
  "description": "brain-memory: SessionStart informa o modo detectado e quantos logs existem; Stop sugere /brain-memory:compress em sessões longas.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/suggest_compress.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
